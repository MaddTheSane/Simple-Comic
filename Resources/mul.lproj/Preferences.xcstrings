    "36.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Pages are never automatically scaled past their actual resolution\"; ObjectID = \"36\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pages are never automatically scaled past their actual resolution"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pages are never automatically scaled past their actual resolution"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ページは実際の解像度を超えて自動的にスケーリングされることはありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "페이지는 실제 해상도를 초과하여 자동으로 확장되지 않습니다."
          }
        }
      }
    },
    "152.ibShadowedToolTip" : {
