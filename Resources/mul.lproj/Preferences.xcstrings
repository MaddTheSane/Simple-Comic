    "Hp-05-pmd.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Keep a file's modification date unchanged when using Set Archive Icon to tag a QuickLook cover page; no other action in Simple Comic touches the source file's date\"; ObjectID = \"Hp-05-pmd\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep a file's modification date unchanged when using Set Archive Icon to tag a QuickLook cover page; no other action in Simple Comic touches the source file's date"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a file's modification date unchanged when using Set Archive Icon to tag a QuickLook cover page; no other action in Simple Comic touches the source file's date"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conservez la date de modification d'un fichier inchangée lorsque vous utilisez l'icône de Récupérer pour étiqueter la page de couverture QuickLook ; aucune autre action dans Simple Comic n'affecte la date du fichier source."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "QuickLookのカバーページにSet Archive Iconを使用してタグを付けるときは、ファイルの変更日を変更しないようにしてください。Simple Comicでの他の操作は、ソースファイルの日付には影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Set Archive Icon을 사용하여 QuickLook 커버 페이지에 태그할 때 파일 수정 날짜를 변경하지 않은 상태로 유지하세요; Simple Comic에서 다른 작업은 소스 파일의 날짜에 영향을 미치지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用“设置存档图标”来标记快速查看封面页时，保持文件的修改日期不变；在Simple Comic中，没有其他操作会影响源文件的日期。"
          }
        }
      }
    },
