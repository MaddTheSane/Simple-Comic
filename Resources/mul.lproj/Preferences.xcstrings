        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As janelas são redimensionadas dinamicamente para se ajustar à visualização da página e à tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Windows会动态调整大小，以适应页面视图和屏幕。"
          }
        }
      }
    },
