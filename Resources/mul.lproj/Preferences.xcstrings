  "strings" : {
    "36.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Pages are never automatically scaled past their actual resolution\"; ObjectID = \"36\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pages are never automatically scaled past their actual resolution"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pages are never automatically scaled past their actual resolution"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les pages ne sont jamais automatiquement agrandies au-delà de leur résolution réelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ページは実際の解像度を超えて自動的にスケーリングされることはありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "페이지는 실제 해상도를 초과하여 자동으로 확장되지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As páginas nunca são dimensionadas automaticamente além de sua resolução real."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "页面永远不会自动超过其实际分辨率进行缩放。"
          }
        }
      }
    },
    "152.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Windows are dynamically resized to fit the page-view and screen\"; ObjectID = \"152\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows are dynamically resized to fit the page-view and screen"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows are dynamically resized to fit the page-view and screen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les fenêtres sont redimensionnées dynamiquement pour s'adapter à la vue de la page et à l'écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Windowsは、ページビューと画面に合わせて動的にサイズ変更されます。"
          }
