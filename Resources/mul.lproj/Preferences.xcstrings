    "234.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Images will not exceed their actual resolution in \\\"fit to window\\\" scaling modes.\"; ObjectID = \"234\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder werden in „An Fenster anpassen“-Ansicht nicht über ihre Originalgröße hinaus vergrößert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Images will not exceed their actual resolution in \"fit to window\" scaling modes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images will not exceed their actual resolution in \"fit to window\" scaling modes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "画像は、「ウィンドウにフィット」スケーリングモードで実際の解像度を超えることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이미지는 \"창에 적합\" 스케일링 모드에서 실제 해상도를 초과하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"最适合窗口\"模式的图片缩放会保持原始比例"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「適合窗口」縮放模式中圖片不會超過其實際分辨率。"
          }
        }
      }
    },
